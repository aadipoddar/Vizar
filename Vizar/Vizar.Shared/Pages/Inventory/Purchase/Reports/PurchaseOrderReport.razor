@page "/report/purchase-order"

@using VizarLibrary.Models.Accounts.Masters
@using VizarLibrary.Models.Fleet.Repair
@using VizarLibrary.Models.Inventory.Purchase
@using VizarLibrary.Models.Operations

<PageTitle>Purchase Order Report - Vizar</PageTitle>

@if (_isLoading)
{
    <AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Purchase Order Report" Subtitle="View and analyze purchase order transactions" ShowHome="true"
                ShowBack="true" ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack"
                OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)"
                            Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)"
                            Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Refresh" Title="Refresh Data (Ctrl + R)" Disabled="_isProcessing"
                            OnClick="LoadTransactionOverviews" />
                <IconButton Icon="IconType.Report" Title="Item Report (Ctrl + I)" Disabled="_isProcessing"
                            OnClick="NavigateToItemReport" />
                <IconButton Icon="IconType.New" Title="New Transaction (Ctrl + N)" Disabled="_isProcessing"
                            OnClick="NavigateToTransactionPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

            <!-- Filters Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                        </svg>
                        <h2 class="section-title">Filters</h2>
                    </div>
                </div>
                <div class="section-body">
                    <div class="filters-container">
                        <div class="filters-grid">
                            <!-- Date Range -->
                            <div class="form-field">
                                <label class="field-label">Date Range</label>
                                <SfDateRangePicker CssClass="custom-daterange" StartDate="_fromDate" EndDate="_toDate"
                                                   TValue="DateTime" Format="dd/MM/yyyy" AllowEdit="true" Placeholder="Select date range">
                                    <DateRangePickerEvents TValue="DateTime" ValueChange="OnDateRangeChanged" />
                                </SfDateRangePicker>
                            </div>

                            <!-- Company -->
                            <div class="form-field">
                                <label class="field-label">Company</label>
                                <SfAutoComplete CssClass="custom-autocomplete" Value="@_selectedCompany"
                                                TValue="CompanyModel" TItem="CompanyModel" DataSource="@_companies"
                                                Placeholder="All Companies" AllowFiltering="true"
                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                    <AutoCompleteEvents TItem="CompanyModel" TValue="CompanyModel"
                                                        ValueChange="OnCompanyChanged" />
                                    <AutoCompleteFieldSettings Value="Name" />
                                </SfAutoComplete>
                            </div>

                            <!-- Vendor -->
                            <div class="form-field">
                                <label class="field-label">Vendor</label>
                                <SfAutoComplete CssClass="custom-autocomplete" Value="@_selectedVendor" TValue="LedgerModel"
                                                TItem="LedgerModel" DataSource="@_vendors" Placeholder="All Vendors"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                    <AutoCompleteEvents TItem="LedgerModel" TValue="LedgerModel"
                                                        ValueChange="OnVendorChanged" />
                                    <AutoCompleteFieldSettings Value="Name" />
                                </SfAutoComplete>
                            </div>

                            <!-- Garage -->
                            <div class="form-field">
                                <label class="field-label">Garage</label>
                                <SfAutoComplete CssClass="custom-autocomplete" Value="@_selectedGarage" TValue="GarageModel"
                                                TItem="GarageModel" DataSource="@_garages" Placeholder="All Garages"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                    <AutoCompleteEvents TItem="GarageModel" TValue="GarageModel"
                                                        ValueChange="OnGarageChanged" />
                                    <AutoCompleteFieldSettings Value="Name" />
                                </SfAutoComplete>
                            </div>

                            <!-- Order Status -->
                            <div class="form-field">
                                <label class="field-label">Order Status</label>
                                <SfDropDownList CssClass="custom-autocomplete" @bind-Value="@_selectedOrderStatus"
                                                TValue="string" TItem="string" DataSource="@_orderStatuses" Placeholder="All Orders">
                                    <DropDownListEvents TValue="string" TItem="string" ValueChange="OnOrderStatusChanged" />
                                </SfDropDownList>
                            </div>
                        </div>

                        <!-- Date Utility Buttons -->
                        <DateRangeButtons Disabled="_isProcessing" FromDate="_fromDate" ToDate="_toDate"
                                          OnDatesChanged="HandleDatesChanged" ToastNotification="_toastNotification" />
                    </div>
                </div>
            </div>

            <!-- Report Grid Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6" />
                            <line x1="8" y1="12" x2="21" y2="12" />
                            <line x1="8" y1="18" x2="21" y2="18" />
                            <line x1="3" y1="6" x2="3.01" y2="6" />
                            <line x1="3" y1="12" x2="3.01" y2="12" />
                            <line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>
                        <h2 class="section-title">Purchase Order Transactions</h2>
                    </div>
                    <div class="header-actions">
                        <ToggleButton Disabled="@_isProcessing" IsActive="@_showSummary"
                                      Variant="ToggleButton.ToggleVariant.Summary"
                                      OnToggle="ToggleSummary" />
                        <ToggleButton Disabled="@_isProcessing" IsActive="@_showDeleted"
                                      Variant="ToggleButton.ToggleVariant.Deleted"
                                      OnToggle="ToggleDeleted" />
                        <ToggleButton Disabled="@_isProcessing" IsActive="@_showAllColumns"
                                      Variant="ToggleButton.ToggleVariant.Details"
                                      OnToggle="ToggleDetailsView" />
                    </div>
                </div>
                <div class="section-body grid-body">
                    <SfGrid ID="_sfGrid" @ref="_sfGrid" TValue="PurchaseOrderOverviewModel"
                            DataSource="_transactionOverviews" AllowTextWrap="true" AllowPaging="true" AllowSorting="true"
                            AllowResizing="true" AllowFiltering="true" AllowExcelExport="true" AllowPdfExport="true"
                            GridLines="GridLine.Horizontal" CssClass="professional-grid" AllowGrouping="true"
                            Toolbar="@(new List<string>() { "Search" })">

                        <GridGroupSettings ShowDropArea="true" ShowGroupedColumn="true" ShowUngroupButton="true" />
                        <GridPageSettings PageSize="20" PageSizes="@(new string[] { "10", "20", "50", "100", "All" })" />
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

                        <GridAggregates>
                            <GridAggregate>
                                <GridAggregateColumns>
                                    <GridAggregateColumn Field="@nameof(PurchaseOrderOverviewModel.TransactionNo)"
                                                         Type="AggregateType.Count">
                                        <FooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                            }
                                            <div class="aggregate-label">
                                                <strong>Total Transactions: @aggregate.Count</strong>
                                            </div>
                                        </FooterTemplate>
                                        <GroupFooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                            }
                                            <div class="aggregate-label">
                                                <strong>Total Transactions: @aggregate.Count</strong>
                                            </div>
                                        </GroupFooterTemplate>
                                        <GroupCaptionTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                            }
                                            <div class="aggregate-label">
                                                <strong>Total Transactions: @aggregate.Count</strong>
                                            </div>
                                        </GroupCaptionTemplate>
                                    </GridAggregateColumn>
                                    <GridAggregateColumn Field="@nameof(PurchaseOrderOverviewModel.TotalItems)"
                                                         Type="AggregateType.Sum" Format="N0">
                                        <FooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </FooterTemplate>
                                        <GroupFooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </GroupFooterTemplate>
                                        <GroupCaptionTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </GroupCaptionTemplate>
                                    </GridAggregateColumn>
                                    <GridAggregateColumn Field="@nameof(PurchaseOrderOverviewModel.TotalQuantity)"
                                                         Type="AggregateType.Sum" Format="N2">
                                        <FooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </FooterTemplate>
                                        <GroupFooterTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </GroupFooterTemplate>
                                        <GroupCaptionTemplate>
                                            @{
                                                var aggregate = (context as AggregateTemplateContext);
                                                <div><strong>@aggregate.Sum</strong></div>
                                            }
                                        </GroupCaptionTemplate>
                                    </GridAggregateColumn>
                                </GridAggregateColumns>
                            </GridAggregate>
                        </GridAggregates>

                        <GridColumns>
                            <GridColumn HeaderText="Actions" Width="180" TextAlign="TextAlign.Center"
                                        Visible="@(!_showSummary)">
                                <Template>
                                    @{
                                        var item = (context as PurchaseOrderOverviewModel);
                                    }
                                    <div class="grid-actions">
                                        @if (!item.Status)
                                        {
                                            <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel"
                                                        Size="ButtonSize.Grid" Title="Download Excel Invoice (Alt + E)"
                                                        Disabled="_isProcessing" OnClick="@(() => DownloadExcelInvoice(item.Id))" />
                                            <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Size="ButtonSize.Grid"
                                                        Title="Download PDF Invoice (Alt + P)" Disabled="_isProcessing"
                                                        OnClick="@(() => DownloadPdfInvoice(item.Id))" />
                                            <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover"
                                                        Size="ButtonSize.Grid" Title="Recover Transaction (Delete)"
                                                        Disabled="_isProcessing"
                                                        OnClick="@(() => ShowRecoverConfirmation(item.Id, item.TransactionNo))" />
                                        }
                                        else
                                        {
                                            <IconButton Icon="IconType.View" Variant="ButtonVariant.View" Size="ButtonSize.Grid"
                                                        Title="View Transaction (Ctrl + O)" Disabled="_isProcessing"
                                                        OnClick="@(() => ViewTransaction(item.Id))" />
                                            <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel"
                                                        Size="ButtonSize.Grid" Title="Download Excel Invoice (Alt + E)"
                                                        Disabled="_isProcessing" OnClick="@(() => DownloadExcelInvoice(item.Id))" />
                                            <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Size="ButtonSize.Grid"
                                                        Title="Download PDF Invoice (Alt + P)" Disabled="_isProcessing"
                                                        OnClick="@(() => DownloadPdfInvoice(item.Id))" />
                                            <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete"
                                                        Size="ButtonSize.Grid" Title="Delete Transaction (Delete)"
                                                        Disabled="_isProcessing"
                                                        OnClick="@(() => ShowDeleteConfirmation(item.Id, item.TransactionNo))" />
                                        }
                                    </div>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.TransactionNo)" HeaderText="Trans No"
                                        Width="170" Visible="@(!_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.TransactionDateTime)" HeaderText="Date"
                                        Width="150" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime"
                                        Visible="@(!_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.CompanyName)" HeaderText="Company"
                                        Width="180" Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.VendorName)" HeaderText="Vendor"
                                        Width="200" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.GarageName)" HeaderText="Garage"
                                        Width="200" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.PurchaseTransactionNo)"
                                        HeaderText="Purchase Trans No" Width="170" Visible="@(!_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.PurchaseDateTime)"
                                        HeaderText="Purchase Date" Width="150" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime"
                                        Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.PurchaseReceiveDateTime)"
                                        HeaderText="Purchase Receive" Width="150" Format="dd/MM/yy" Type="ColumnType.DateTime"
                                        Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.FinancialYear)"
                                        HeaderText="Financial Year" Width="150" Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.TotalItems)" HeaderText="Items"
                                        Width="100" Format="N0" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.TotalQuantity)" HeaderText="Quantity"
                                        Width="120" Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.Remarks)" HeaderText="Remarks" Width="200"
                                        Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.CreatedByName)" HeaderText="Created By"
                                        Width="150" Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.CreatedAt)" HeaderText="Created At"
                                        Width="160" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime"
                                        Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.CreatedFromPlatform)"
                                        HeaderText="Created Platform" Width="200" Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.LastModifiedByUserName)"
                                        HeaderText="Modified By" Width="150" Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.LastModifiedAt)" HeaderText="Modified At"
                                        Width="160" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime"
                                        Visible="@(_showAllColumns && !_showSummary)" />
                            <GridColumn Field="@nameof(PurchaseOrderOverviewModel.LastModifiedFromPlatform)"
                                        HeaderText="Modified Platform" Width="200" Visible="@(_showAllColumns && !_showSummary)" />
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        </div>

        <Footer />
    </div>
}

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog" EntityName="Purchase Order Transaction"
                          IdentifierLabel="Transaction No" IdentifierValue="@_deleteTransactionNo" IsPermanentDelete="true"
                          Disabled="@_isProcessing" OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog" EntityName="Purchase Order Transaction"
                           IdentifierLabel="Transaction No" IdentifierValue="@_recoverTransactionNo" Disabled="@_isProcessing"
                           OnConfirm="ConfirmRecover" OnCancel="CancelRecover" />

<ToastNotification @ref="_toastNotification" />