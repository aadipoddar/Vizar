@page "/login-with-code"

<PageTitle>Login with Code - Vizar</PageTitle>

<div class="login-container">
    <div class="login-card">
        <!-- Logo Section -->
        <div class="logo-section">
            <img src="images/logo_full.png" alt="Vizar Logo" class="login-logo" />
        </div>

        <!-- Title Section -->
        <div class="title-section">
            <p class="login-subtitle">Login with verification code</p>
        </div>

        <!-- Login Form -->
        <div class="form-section">
            @if (!_isCodeSent)
            {
                <!-- Phone/Email Input -->
                <div class="input-group">
                    <label class="input-label">Phone / Email</label>
                    <SfTextBox @ref="_phoneEmailTextBox" @bind-Value="_phoneEmail" Placeholder="Enter phone number or email"
                        CssClass="custom-textbox" ShowClearButton="true">
                    </SfTextBox>
                </div>

                <!-- Send Code Button -->
                <div class="button-group">
                    <button class="btn-login" @onclick="OnSendCodeClick" disabled="@_isVerifying">
                        @if (_isVerifying)
                        {
                            <span class="spinner"></span>
                            <span>Sending Code...</span>
                        }
                        else
                        {
                            <span>Send Verification Code</span>
                        }
                    </button>
                </div>
            }
            else
            {
                <!-- OTP Input -->
                <div class="input-group">
                    <label class="input-label">Verification Code</label>
                    <div class="otp-container">
                        <SfOtpInput @ref="_otpInput" @bind-Value="_otpCode" Length="6" CssClass="custom-otp"
                            Placeholder="@_codePlaceholder">
                        </SfOtpInput>
                    </div>
                    <p class="code-hint">@_codePlaceholder</p>
                </div>

                @if (_isEnabledUsersResetPassword)
                {
                    <!-- New Password Input (Optional) -->
                    <div class="input-group">
                        <label class="input-label">New Password (Optional)</label>
                        <SfTextBox @ref="_newPasswordTextBox" @bind-Value="_newPassword" Type="InputType.Password"
                            Placeholder="Enter new password (min 6 characters)" CssClass="custom-textbox" ShowClearButton="true">
                        </SfTextBox>
                    </div>
                }

                <!-- Login Button -->
                <div class="button-group">
                    <button class="btn-login" @onclick="OnLoginWithCodeClick" disabled="@_isVerifying">
                        @if (_isVerifying)
                        {
                            <span class="spinner"></span>
                            <span>Verifying...</span>
                        }
                        else
                        {
                            <span>Verify & Login</span>
                        }
                    </button>
                </div>

                <!-- Resend Code Link -->
                <div class="forgot-password-section">
                    <a class="forgot-password-link" @onclick="OnSendCodeClick">
                        Resend Code
                    </a>
                </div>
            }

            <!-- Back to Login Link -->
            <div class="forgot-password-section" style="margin-top: 8px;">
                <a class="forgot-password-link" href="/login">
                    Back to Login
                </a>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-section">
            <p class="copyright">
                &copy; @DateTime.Now.Year A Product By
                <a href="https://aadisoft.vercel.app" target="_blank" class="footer-link">AadiSoft</a>.
                All rights reserved.
            </p>
        </div>
    </div>
</div>

<ToastNotification @ref="_toastNotification" />

<style>
    * {
        box-sizing: border-box;
    }

    /* Color Variables - Matching Dashboard Theme */
    :root {
        --primary-color: #3b82f6;
        --primary-dark: #2563eb;
        --primary-light: #60a5fa;
        --secondary-color: #f8fafc;
        --text-dark: #1e293b;
        --text-light: #64748b;
        --white: #ffffff;
        --border-color: #e2e8f0;
        --shadow: 0 10px 40px rgba(59, 130, 246, 0.15);
        --shadow-hover: 0 15px 50px rgba(59, 130, 246, 0.25);
        --border-radius: 16px;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Login Container */
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
        background: var(--secondary-color);
        position: relative;
    }

    /* Login Card */
    .login-card {
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        padding: 48px 40px;
        width: 100%;
        max-width: 450px;
        position: relative;
        z-index: 10;
        animation: slideUp 0.4s ease;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Logo Section */
    .logo-section {
        text-align: center;
        margin-bottom: 32px;
    }

    .login-logo {
        width: 400px;
        height: auto;
        object-fit: contain;
    }

    /* Title Section */
    .title-section {
        text-align: center;
        margin-bottom: 40px;
    }

    .login-subtitle {
        font-size: 16px;
        color: var(--text-light);
        margin: 0;
        font-weight: 400;
    }

    /* Form Section */
    .form-section {
        margin-bottom: 24px;
    }

    .input-group {
        margin-bottom: 24px;
    }

    .input-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 8px;
    }

    /* Syncfusion TextBox Styling */
    :deep(.custom-textbox) {
        width: 100%;
    }

    :deep(.custom-textbox .e-input-group) {
        border-radius: 12px;
        border: 2px solid var(--border-color);
        transition: all 0.3s ease;
    }

    :deep(.custom-textbox .e-input-group:focus-within) {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    :deep(.custom-textbox .e-input-group input) {
        padding: 12px 16px;
        font-size: 15px;
        color: var(--text-dark);
    }

    :deep(.custom-textbox .e-input-group input::placeholder) {
        color: var(--text-light);
    }

    /* OTP Input Styling */
    .otp-container {
        margin-bottom: 8px;
    }

    :deep(.custom-otp) {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    :deep(.custom-otp .e-input-group) {
        flex: 1;
        border-radius: 12px;
        border: 2px solid var(--border-color);
        transition: all 0.3s ease;
    }

    :deep(.custom-otp .e-input-group:focus-within) {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    :deep(.custom-otp .e-input-group input) {
        padding: 12px;
        font-size: 18px;
        font-weight: 600;
        color: var(--text-dark);
        text-align: center;
    }

    .code-hint {
        font-size: 12px;
        color: var(--text-light);
        margin: 0;
        line-height: 1.4;
    }

    /* Button Group */
    .button-group {
        margin-top: 32px;
    }

    .btn-login {
        width: 100%;
        padding: 14px 24px;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: var(--white);
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-login:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .btn-login:active:not(:disabled) {
        transform: translateY(0);
    }

    .btn-login:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    /* Spinner */
    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-left: 2px solid var(--white);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Forgot Password Section */
    .forgot-password-section {
        text-align: center;
        margin-top: 16px;
    }

    .forgot-password-link {
        color: var(--primary-color);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .forgot-password-link:hover {
        color: var(--primary-dark);
        text-decoration: underline;
    }

    /* Footer Section */
    .footer-section {
        text-align: center;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .copyright {
        font-size: 13px;
        color: var(--text-light);
        line-height: 1.5;
        margin: 0;
    }

    .footer-link {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .footer-link:hover {
        color: var(--primary-dark);
        text-decoration: underline;
    }

    .footer-link:focus {
        outline: 2px solid var(--primary-color);
        outline-offset: 2px;
        border-radius: 2px;
    }

    /* Responsive Design */
    @@media (max-width: 480px) {
        .login-card {
            padding: 32px 24px;
        }

        .login-logo {
            width: 150px;
        }

        :deep(.custom-otp) {
            gap: 4px;
        }

        :deep(.custom-otp .e-input-group input) {
            padding: 10px;
            font-size: 16px;
        }
    }

    /* Accessibility */
    @@media (prefers-reduced-motion: reduce) {

        .spinner,
        .login-card {
            animation: none;
        }

        .btn-login:hover:not(:disabled) {
            transform: none;
        }
    }

    /* High contrast mode support */
    @@media (prefers-contrast: high) {
        .login-card {
            border: 2px solid var(--text-dark);
        }

        :deep(.custom-textbox .e-input-group),
        :deep(.custom-otp .e-input-group) {
            border-width: 3px;
        }
    }
</style>

