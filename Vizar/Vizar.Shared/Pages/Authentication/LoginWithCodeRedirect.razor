@page "/login-with-code-redirect/{Id}/{Code}"

<PageTitle>Login With Code Redirect - Vizar</PageTitle>

<div class="redirect-container">
	<div class="redirect-card">
		<div class="logo-container">
			<img src="images/logo.png" alt="Vizar Logo" class="company-logo" />
			<h1 class="logo-text">Vizar</h1>
		</div>
		
		<div class="loading-content">
			<div class="spinner-container">
				<div class="spinner"></div>
			</div>
			<h2 class="loading-title">Verifying Your Login</h2>
			<p class="loading-subtitle">Please wait while we securely log you in...</p>
		</div>

		<div class="loading-dots">
			<span class="dot"></span>
			<span class="dot"></span>
			<span class="dot"></span>
		</div>
	</div>
</div>

<style>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0;
	}

	.redirect-container {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
		padding: 20px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', Arial, sans-serif;
		position: relative;
		overflow: hidden;
	}

		.redirect-container::before {
			content: '';
			position: absolute;
			top: -50%;
			right: -50%;
			width: 100%;
			height: 100%;
			background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
			pointer-events: none;
		}

		.redirect-container::after {
			content: '';
			position: absolute;
			bottom: -50%;
			left: -50%;
			width: 100%;
			height: 100%;
			background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
			pointer-events: none;
		}

	.redirect-card {
		width: 100%;
		max-width: 480px;
		background: #ffffff;
		border-radius: 16px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
		padding: 60px 40px;
		text-align: center;
		animation: fadeIn 0.5s ease-out;
		position: relative;
		z-index: 1;
		border: 1px solid rgba(0, 0, 0, 0.06);
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: scale(0.95);
		}

		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.logo-container {
		margin-bottom: 40px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.company-logo {
		width: 80px;
		height: 80px;
		animation: logoFloat 3s ease-in-out infinite;
	}

	@@keyframes logoFloat {
		0%, 100% {
			transform: translateY(0px);
		}

		50% {
			transform: translateY(-10px);
		}
	}

	.logo-text {
		font-size: 36px;
		font-weight: 600;
		margin: 0;
		letter-spacing: -0.5px;
		color: #3b82f6;
		background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.loading-content {
		margin-bottom: 40px;
	}

	.spinner-container {
		margin-bottom: 32px;
		display: flex;
		justify-content: center;
	}

	.spinner {
		width: 64px;
		height: 64px;
		border: 4px solid #e2e8f0;
		border-top: 4px solid #3b82f6;
		border-radius: 50%;
		animation: spin 1s linear infinite;
	}

	@@keyframes spin {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

	.loading-title {
		font-size: 24px;
		font-weight: 600;
		color: #0f172a;
		margin: 0 0 12px 0;
		letter-spacing: -0.3px;
	}

	.loading-subtitle {
		font-size: 15px;
		color: #64748b;
		margin: 0;
		line-height: 1.6;
	}

	.loading-dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: 20px;
	}

	.dot {
		width: 10px;
		height: 10px;
		background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
		border-radius: 50%;
		animation: bounce 1.4s infinite ease-in-out both;
	}

		.dot:nth-child(1) {
			animation-delay: -0.32s;
		}

		.dot:nth-child(2) {
			animation-delay: -0.16s;
		}

	@@keyframes bounce {
		0%, 80%, 100% {
			transform: scale(0);
			opacity: 0.5;
		}

		40% {
			transform: scale(1);
			opacity: 1;
		}
	}

	/* Responsive Design */
	@@media (max-width: 640px) {
		.redirect-container {
			padding: 16px;
		}

		.redirect-card {
			padding: 48px 28px;
			border-radius: 12px;
		}

		.company-logo {
			width: 64px;
			height: 64px;
		}

		.logo-text {
			font-size: 32px;
		}

		.loading-title {
			font-size: 22px;
		}

		.loading-subtitle {
			font-size: 14px;
		}

		.spinner {
			width: 56px;
			height: 56px;
		}
	}

	@@media (max-width: 400px) {
		.redirect-card {
			padding: 40px 24px;
		}

		.company-logo {
			width: 56px;
			height: 56px;
		}

		.logo-text {
			font-size: 28px;
		}

		.loading-title {
			font-size: 20px;
		}

		.spinner {
			width: 48px;
			height: 48px;
		}
	}
</style>
