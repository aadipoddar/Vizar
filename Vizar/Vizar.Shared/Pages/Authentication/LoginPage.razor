@page "/login"
<PageTitle>Login - Vizar</PageTitle>

<div class="login-container">
	<div class="login-card">
		<!-- Header Section -->
		<div class="login-header">
			<div class="logo-container">
				<img src="images/logo.png" alt="Vizar Logo" class="company-logo" />
				<h1 class="logo-text">Vizar</h1>
			</div>
			<h2 class="welcome-text">Welcome Back</h2>
			<p class="subtitle">Please login to your account</p>
		</div>

		<!-- Form Section -->
		<div class="login-form">
			<!-- Phone/Email Input -->
			<div class="form-group">
				<SfTextBox Placeholder="Email or Phone Number"
						   FloatLabelType="FloatLabelType.Auto"
						   Value="@_phoneEmail"
						   @ref="_phoneEmailTextBox"
						   Input="OnPhoneEmailInput"
						   CssClass="custom-input" />
			</div>

			<!-- Password Input -->
			<div class="form-group">
				<SfTextBox Placeholder="@_passwordPlaceholder"
						   FloatLabelType="FloatLabelType.Auto"
						   Value="@_password"
						   @ref="_passwordTextBox"
						   Input="OnPasswordInput"
						   Type="InputType.Password"
						   CssClass="custom-input" />
			</div>

			<!-- Forgot Password Link -->
			@if (_isLoginWithCodeEnabled)
			{
				<div class="forgot-password-section">
					<p class="forgot-link" @onclick="OnForgotPasswordClick">
						<svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
						</svg>
						Forgot Password? Login with Code
					</p>
				</div>
			}

			<!-- Login Button -->
			<div class="form-group">
				<SfButton Content="@(_isVerifying ? "Logging in..." : "Login to Vizar")"
						  OnClick="OnLoginClick"
						  Disabled="_isVerifying"
						  CssClass="btn-login" />
			</div>
		</div>
	</div>

	<!-- Footer -->
	<div class="login-footer">
		<p>© @DateTime.Now.Year A Product By <a href="https://aadisoft.vercel.app" target="_blank">AadiSoft</a>. All rights reserved.</p>
	</div>
</div>

<!-- Toast Notifications -->
<SfToast @ref="_sfErrorToast"
		 ID="_sfErrorToast"
		 Title="@_errorTitle"
		 Content="@_errorMessage"
		 Timeout="5000"
		 CssClass="error-toast">
	<ToastPosition X="Right" Y="Top" />
	<ToastShowAnimationSettings Effect="ToastEffect.SlideLeftIn" />
	<ToastHideAnimationSettings Effect="ToastEffect.SlideRightOut" />
</SfToast>

<style>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0;
	}

	.login-container {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
		padding: 20px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', Arial, sans-serif;
		position: relative;
		overflow: hidden;
	}

		.login-container::before {
			content: '';
			position: absolute;
			top: -50%;
			right: -50%;
			width: 100%;
			height: 100%;
			background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
			pointer-events: none;
		}

		.login-container::after {
			content: '';
			position: absolute;
			bottom: -50%;
			left: -50%;
			width: 100%;
			height: 100%;
			background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
			pointer-events: none;
		}

	.login-card {
		width: 100%;
		max-width: 480px;
		background: #ffffff;
		border-radius: 12px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
		overflow: hidden;
		animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		z-index: 1;
		border: 1px solid rgba(0, 0, 0, 0.06);
	}

	@@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.login-header {
		background: #ffffff;
		padding: 48px 40px 32px;
		text-align: center;
		color: #1e293b;
		border-bottom: 1px solid #f1f5f9;
	}

	.logo-container {
		margin-bottom: 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.company-logo {
		width: 64px;
		height: 64px;
		animation: logoFloat 3s ease-in-out infinite;
	}

	@@keyframes logoFloat {
		0%, 100% {
			transform: translateY(0px);
		}

		50% {
			transform: translateY(-8px);
		}
	}

	.logo-text {
		font-size: 32px;
		font-weight: 600;
		margin: 0;
		letter-spacing: -0.5px;
		color: #3b82f6;
		background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.welcome-text {
		font-size: 22px;
		font-weight: 600;
		margin: 0 0 8px 0;
		color: #0f172a;
	}

	.subtitle {
		font-size: 14px;
		color: #64748b;
		margin: 0;
		font-weight: 400;
	}

	.login-form {
		padding: 40px 40px 48px;
		background: #ffffff;
	}

	.form-group {
		margin-bottom: 20px;
	}

		.form-group:last-of-type {
			margin-bottom: 0;
		}

	.forgot-password-section {
		margin-bottom: 28px;
		text-align: right;
		margin-top: -4px;
	}

	.forgot-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #3b82f6;
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
		margin: 0;
		padding: 4px 0;
	}

		.forgot-link:hover {
			color: #2563eb;
			text-decoration: none;
		}

		.forgot-link:active {
			transform: scale(0.98);
		}

	.link-icon {
		width: 14px;
		height: 14px;
		opacity: 0.8;
	}

	.login-footer {
		margin-top: 32px;
		text-align: center;
		color: #64748b;
		font-size: 13px;
		position: relative;
		z-index: 1;
	}

		.login-footer p {
			margin: 0;
		}

		.login-footer a {
			color: #3b82f6;
			font-weight: 500;
			text-decoration: none;
			transition: color 0.2s ease;
		}

			.login-footer a:hover {
				color: #2563eb;
				text-decoration: none;
			}

	/* Syncfusion Component Overrides */
	::deep .custom-input,
	::deep .custom-input .e-input-group,
	::deep .custom-input .e-input-group input {
		height: 44px;
		font-size: 14px;
		border-radius: 6px;
	}

	::deep .custom-input .e-input-group {
		border: 1px solid #e2e8f0;
		background: #ffffff;
		transition: all 0.2s ease;
	}

		::deep .custom-input .e-input-group:hover {
			border-color: #cbd5e1;
		}

		::deep .custom-input .e-input-group:focus-within {
			border-color: #3b82f6;
			box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
		}

	::deep .custom-input .e-input-group input {
		color: #1e293b;
		font-weight: 400;
	}

		::deep .custom-input .e-input-group input::placeholder {
			color: #94a3b8;
		}

	::deep .custom-input .e-float-text {
		color: #64748b;
		font-weight: 500;
		font-size: 13px;
	}

	::deep .custom-input .e-input-group.e-input-focus .e-float-text,
	::deep .custom-input .e-input-group.e-valid-input .e-float-text {
		color: #3b82f6;
	}

	::deep .btn-login {
		width: 100%;
		height: 48px;
		font-size: 15px;
		font-weight: 600;
		border: none;
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		text-transform: none;
		background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
		color: #ffffff;
		box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.4);
		letter-spacing: 0.5px;
		position: relative;
		overflow: hidden;
	}

		::deep .btn-login::before {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
			transition: left 0.5s;
		}

		::deep .btn-login:hover:not(:disabled) {
			box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5), 0 2px 8px rgba(0, 0, 0, 0.1);
			transform: translateY(-2px);
			background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
		}

		::deep .btn-login:hover:not(:disabled)::before {
			left: 100%;
		}

		::deep .btn-login:active:not(:disabled) {
			transform: translateY(0);
			box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
			transition: all 0.1s;
		}

		::deep .btn-login:disabled {
			opacity: 0.6;
			cursor: not-allowed;
			transform: none !important;
			box-shadow: 0 2px 8px rgba(59, 130, 246, 0.2) !important;
		}

	/* Toast Styles */
	::deep .error-toast .e-toast {
		background: #ef4444;
		color: #ffffff;
		border-radius: 8px;
		box-shadow: 0 10px 25px rgba(239, 68, 68, 0.3);
	}

	/* Responsive Design */
	@@media (max-width: 640px) {
		.login-container {
			padding: 16px;
		}

		.login-card {
			border-radius: 10px;
			max-width: 100%;
		}

		.login-header {
			padding: 36px 24px 24px;
		}

		.logo-text {
			font-size: 28px;
		}

		.welcome-text {
			font-size: 20px;
		}

		.subtitle {
			font-size: 13px;
		}

		.login-form {
			padding: 32px 24px 36px;
		}

		.forgot-password-section {
			text-align: center;
			margin-top: 0;
		}

		.login-footer {
			margin-top: 24px;
			font-size: 12px;
		}
	}

	@@media (max-width: 400px) {
		.login-header {
			padding: 32px 20px 20px;
		}

		.login-form {
			padding: 28px 20px 32px;
		}
	}
</style>