@page "/fleet/document"

@using VizarLibrary.Models.Fleet.Document
@using VizarLibrary.Models.Fleet.Vehicle
@using VizarLibrary.Models.Inventory.Item

<PageTitle>Document Management - Vizar</PageTitle>

@if (_isLoading)
{
    <AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Document Management" Subtitle="Manage documents and details" ShowHome="true" ShowBack="true"
                ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack" OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)"
                            Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)"
                            Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Document (Ctrl + S)"
                            Disabled="_isProcessing" OnClick="SaveDocument" />
                <IconButton Icon="IconType.Upload" Title="Upload Document (Ctrl + U)" Disabled="_isProcessing"
                            OnClick="UploadDocument" />
                <IconButton Icon="IconType.New" Title="New Document (Ctrl + N)" Disabled="_isProcessing"
                            OnClick="ResetPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

            <!-- Item Category Entry Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5" />
                        </svg>
                        <h2 class="section-title">Document Details</h2>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-grid">
                        <!-- Transaction No -->
                        <div class="form-field">
                            <label class="field-label">
                                Transaction No <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_document.TransactionNo" Placeholder="Enter transaction number"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Transaction Date Time -->
                        <div class="form-field">
                            <label class="field-label">
                                Renewal Date <span class="required">*</span>
                            </label>
                            <SfDatePicker TValue="DateTime" @bind-Value="_document.TransactionDateTime"
                                          Placeholder="Select Renewal Date" Format="dd-MM-yyyy" FloatLabelType="FloatLabelType.Never"
                                          CssClass="custom-textbox" />
                        </div>

                        <!-- Document Type -->
                        <div class="form-field">
                            <label class="field-label">
                                Document Type <span class="required">*</span>
                            </label>
                            <SfAutoComplete TItem="DocumentTypeModel" TValue="DocumentTypeModel"
                                            Value="@(_documentTypes.FirstOrDefault(v => v.Id == _document.DocumentTypeId))"
                                            DataSource="@_documentTypes" Placeholder="Select document type"
                                            FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox">
                                <AutoCompleteFieldSettings Value="Name" />
                                <AutoCompleteEvents TItem="DocumentTypeModel" TValue="DocumentTypeModel"
                                                    ValueChange="OnDocumentTypeChanged" />
                            </SfAutoComplete>
                        </div>

                        <!-- Vehicle -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle <span class="required">*</span>
                            </label>
                            <SfAutoComplete TValue="VehicleModel" TItem="VehicleModel" DataSource="@_vehicles"
                                            Value="@(_vehicles.FirstOrDefault(v => v.Id == _document.VehicleId))"
                                            Placeholder="Select Vehicle" FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" CssClass="custom-autocomplete">
                                <AutoCompleteEvents TItem="VehicleModel" TValue="VehicleModel"
                                                    ValueChange="OnVehicleChanged" />
                                <AutoCompleteFieldSettings Value="Code" />
                                <AutoCompleteTemplates TItem="VehicleModel">
                                    <ItemTemplate>
                                        @{
                                            var vehicle = context as VehicleModel;
                                        }
                                        <span>
                                            @vehicle.Code @(!string.IsNullOrEmpty(vehicle.ShortCode) ?
                                            $"({vehicle.ShortCode})" : "")
                                        </span>
                                    </ItemTemplate>
                                </AutoCompleteTemplates>
                            </SfAutoComplete>
                        </div>

                        <!-- Current Hour -->
                        <div class="form-field">
                            <label class="field-label">Current Hour</label>
                            <SfNumericTextBox TValue="decimal?" @bind-Value="_document.CurrentHour"
                                              Placeholder="Enter current hour" Format="N2" Min="0" ShowSpinButton="false"
                                              FloatLabelType="FloatLabelType.Never" CssClass="custom-numeric" />
                        </div>

                        <!-- Current KM -->
                        <div class="form-field">
                            <label class="field-label">Current KM</label>
                            <SfNumericTextBox TValue="decimal?" @bind-Value="_document.CurrentKM"
                                              Placeholder="Enter current KM" Format="N2" Min="0" ShowSpinButton="false"
                                              FloatLabelType="FloatLabelType.Never" CssClass="custom-numeric" />
                        </div>

                        <!-- Rate -->
                        <div class="form-field">
                            <label class="field-label">
                                Rate <span class="required">*</span>
                            </label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_document.Rate" Placeholder="Enter rate"
                                              Format="N2" Min="0" ShowSpinButton="false" FloatLabelType="FloatLabelType.Never"
                                              CssClass="custom-numeric" />
                        </div>

                        <!-- Renewal Date -->
                        <div class="form-field">
                            <label class="field-label">
                                Next Renewal Date <span class="required">*</span>
                            </label>
                            <SfDatePicker TValue="DateTime" @bind-Value="_document.RenewalDate"
                                          Placeholder="Select Next Renewal Date" Format="dd-MM-yyyy"
                                          FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Remarks -->
                        <div class="form-field">
                            <label class="field-label">Remarks</label>
                            <SfTextBox @bind-Value="_document.Remarks" Placeholder="Enter remarks (optional)"
                                       Multiline="true" FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kitchens List Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                        <h2 class="section-title">Documents List</h2>
                    </div>
                    <div class="header-actions">
                        <ToggleDeletedButton Disabled="@_isProcessing" ShowDeleted="@_showDeleted"
                                             OnToggle="ToggleDeleted" />
                    </div>
                </div>
                <div class="section-body grid-body">
                    <SfGrid @ref="_sfGrid" DataSource="@_documents" AllowPaging="true" AllowSorting="true"
                            AllowFiltering="true" AllowResizing="true" CssClass="professional-grid"
                            Toolbar="@(new List<string>() { "Search" })">
                        <GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                        <GridColumns>
                            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"
                                        AllowFiltering="false">
                                <Template>
                                    @{
                                        var item = (context as DocumentOverviewModel);

                                        <div class="grid-actions">
                                            @if (item.Status)
                                            {
                                                <IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid"
                                                            Title="Edit (Insert)" OnClick="@(() => OnEditDocument(item))" />
                                                <IconButton Icon="IconType.Download" Variant="ButtonVariant.Default"
                                                            Size="ButtonSize.Grid" Title="Download Original"
                                                            Disabled="@(string.IsNullOrEmpty(item.DocumentUrl) || _isProcessing)"
                                                            OnClick="@(() => DownloadOriginalInvoice(item.DocumentUrl))" />
                                                <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete"
                                                            Size="ButtonSize.Grid" Title="Delete (Delete)"
                                                            OnClick="@(() => ShowDeleteConfirmation(item.Id, item.TransactionNo))" />
                                            }
                                            else
                                            {
                                                <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover"
                                                            Size="ButtonSize.Grid" Title="Recover (Delete)"
                                                            OnClick="@(() => ShowRecoverConfirmation(item.Id, item.TransactionNo))" />
                                            }
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(DocumentOverviewModel.Id)" HeaderText="ID" Width="80"
                                        TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.TransactionNo)" HeaderText="Document No"
                                        Width="200" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.TransactionDateTime)" HeaderText="Renewal Date"
                                        Width="150" Format="dd-MMM-yyyy" TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.FinancialYear)" HeaderText="Financial Year"
                                        Width="180" TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.DocumentType)" HeaderText="Type" Width="150" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.Vehicle)" HeaderText="Vehicle" Width="150" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.CurrentHour)" HeaderText="Hour" Width="120"
                                        Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.CurrentKM)" HeaderText="KM" Width="120"
                                        Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.Rate)" HeaderText="Rate" Width="100"
                                        Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.RenewalDate)" HeaderText="Next Renewal Date"
                                        Width="150" Format="dd-MMM-yyyy" TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.Status)" HeaderText="Status" Width="100"
                                        TextAlign="TextAlign.Center">
                                <Template>
                                    @{
                                        var document = (context as DocumentOverviewModel);
                                        <div class="grid-checkbox"
                                             style="@(document.Status ? "color: #10b981; background: #d1fae5;" : "color: #dc2626; background: #fee2e2;")">
                                            @(document.Status ? "✓" : "✗")
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(DocumentOverviewModel.Remarks)" HeaderText="Remarks" Width="200" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.CreatedByName)" HeaderText="Created By"
                                        Width="150" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.CreatedAt)" HeaderText="Created At" Width="160"
                                        Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.CreatedFromPlatform)"
                                        HeaderText="Created Platform" Width="200" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.LastModifiedByUserName)"
                                        HeaderText="Modified By" Width="150" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.LastModifiedAt)" HeaderText="Modified At"
                                        Width="160" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" />
                            <GridColumn Field="@nameof(DocumentOverviewModel.LastModifiedFromPlatform)"
                                        HeaderText="Modified Platform" Width="200" />
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>

        </div>

        <Footer />
    </div>
}

<DocumentUploadDialog @ref="_uploadDocumentDialog" Title="Upload Original Document"
                      InfoMessage="Upload the original document for record keeping and future reference."
                      ExistingDocumentUrl="@_document.DocumentUrl" ShowInterpretButton="false" @bind-IsVisible="_isUploadDialogVisible"
                      UploaderReference="_sfDocumentUploader" OnFileChange="OnUploaderFileChange" OnFileRemove="OnRemoveFile"
                      OnDownloadClick="DownloadExistingDocument" OnRemoveClick="RemoveExistingDocument" OnClose="CloseUploadDialog" />

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog" EntityName="Document" IdentifierLabel="Document Name"
                          IdentifierValue="@_deleteDocumentName" IsPermanentDelete="false" Disabled="@_isProcessing" OnConfirm="ConfirmDelete"
                          OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog" EntityName="Document" IdentifierLabel="Document Name"
                           IdentifierValue="@_recoverDocumentName" Disabled="@_isProcessing" OnConfirm="ConfirmRecover"
                           OnCancel="CancelRecover" />

<ToastNotification @ref="_toastNotification" />