@page "/admin/document-type"

@using VizarLibrary.Models.Fleet.Document

<PageTitle>Document Type Management - Vizar</PageTitle>

@if (_isLoading)
{
    <AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Document Type Management" Subtitle="Manage document types and details" ShowHome="true" ShowBack="true" ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack" OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)" Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)" Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Document Type (Ctrl + S)" Disabled="_isProcessing" OnClick="SaveDocumentType" />
                <IconButton Icon="IconType.New" Title="New Document Type (Ctrl + N)" Disabled="_isProcessing" OnClick="ResetPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

        <!-- Document Type Entry Section -->
        <div class="section-card">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5" />
                    </svg>
                    <h2 class="section-title">Document Type Details</h2>
                </div>
            </div>
            <div class="section-body">
                <div class="form-grid-triple">
                    <!-- Document Type Name -->
                    <div class="form-field">
                        <label class="field-label">
                            Document Type Name <span class="required">*</span>
                        </label>
                        <SfTextBox @bind-Value="_documentType.Name" Placeholder="Enter document type name"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Document Type Code <span class="required">*</span>
                        </label>
                        <SfTextBox Value="@_documentType.Code" Placeholder="Auto-generated" Readonly="true"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>

                    <!-- Rate -->
                    <div class="form-field">
                        <label class="field-label">Rate</label>
                        <SfNumericTextBox @bind-Value="_documentType.Rate" TValue="decimal" Format="0.00" 
                                          Placeholder="Enter rate" FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>

                    <!-- Remarks -->
                    <div class="form-field">
                        <label class="field-label">Remarks</label>
                        <SfTextBox @bind-Value="_documentType.Remarks" Placeholder="Enter remarks (optional)" Multiline="true"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Document Types List Section -->
        <div class="section-card">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                    </svg>
                    <h2 class="section-title">Document Types List</h2>
                </div>
                <div class="header-actions">
                    <ToggleDeletedButton Disabled="@_isProcessing" ShowDeleted="@_showDeleted" OnToggle="ToggleDeleted" />
                </div>
            </div>
            <div class="section-body grid-body">
                <SfGrid @ref="_sfGrid" DataSource="@_documentTypes" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                        AllowResizing="true" CssClass="professional-grid" Toolbar="@(new List<string>() { "Search" })">
                    <GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                    <GridColumns>
                        <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center" AllowFiltering="false">
                            <Template>
                                @{
                                    var documentType = (context as DocumentTypeModel);

                                    <div class="grid-actions">
                                        @if (documentType.Status)
                                        {
                                            <IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid" Title="Edit (Insert)" OnClick="@(() => OnEditDocumentType(documentType))" />
                                            <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete" Size="ButtonSize.Grid" Title="Delete (Delete)" OnClick="@(() => ShowDeleteConfirmation(documentType.Id, documentType.Name))" />
                                        }
                                        else
                                        {
                                            <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover" Size="ButtonSize.Grid" Title="Recover (Delete)" OnClick="@(() => ShowRecoverConfirmation(documentType.Id, documentType.Name))" />
                                        }
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(DocumentTypeModel.Id)" HeaderText="ID" Width="80" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(DocumentTypeModel.Name)" HeaderText="Name" Width="300" />
                        <GridColumn Field="@nameof(DocumentTypeModel.Code)" HeaderText="Code" Width="200" />
                        <GridColumn Field="@nameof(DocumentTypeModel.Rate)" HeaderText="Rate" Format="#,##0.00" Width="150" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(DocumentTypeModel.Remarks)" HeaderText="Remarks" Width="300" />
                        <GridColumn Field="@nameof(DocumentTypeModel.Status)" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var documentType = (context as DocumentTypeModel);
                                    <div class="grid-checkbox" style="@(documentType.Status ? "color: #10b981; background: #d1fae5;" : "color: #dc2626; background: #fee2e2;")">
                                        @(documentType.Status ? "✓" : "✗")
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>

        </div>

        <Footer />
    </div>
}

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog"
                          EntityName="Document Type"
                          IdentifierLabel="Document Type Name"
                          IdentifierValue="@_deleteDocumentTypeName"
                          IsPermanentDelete="false"
                          Disabled="@_isProcessing"
                          OnConfirm="ConfirmDelete"
                          OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog"
                           EntityName="Document Type"
                           IdentifierLabel="Document Type Name"
                           IdentifierValue="@_recoverDocumentTypeName"
                           Disabled="@_isProcessing"
                           OnConfirm="ConfirmRecover"
                           OnCancel="CancelRecover" />

<!-- Toast Notification -->
<ToastNotification @ref="_toastNotification" />

<style>
    * {
        box-sizing: border-box;
    }

    /* Section Card */
    .section-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .section-header {
        padding: 20px 24px;
        border-bottom: 2px solid #e2e8f0;
        background: linear-gradient(to bottom, #ffffff 0%, #f8fafc 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .section-icon {
        color: #3b82f6;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .section-body {
        padding: 24px;
    }

    /* Form Grid */
    .form-grid-triple {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        align-items: start;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-field-span-2 {
        grid-column: span 2;
    }

    .form-field-span-3 {
        grid-column: span 3;
    }

    .field-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 2px;
    }

    .required {
        color: #dc2626;
        margin-left: 2px;
    }

    /* Grid Body */
    .grid-body {
        padding: 0;
    }

    .professional-grid {
        border: none;
    }

    .grid-checkbox {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
    }

    .grid-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    /* Page Container */
    .page-container {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
    }

    @@media (max-width: 1200px) {
        .form-grid-triple {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .page-container {
            padding: 16px;
        }

        .section-body {
            padding: 16px;
        }

        .form-grid-triple {
            grid-template-columns: 1fr;
        }
    }
</style>


