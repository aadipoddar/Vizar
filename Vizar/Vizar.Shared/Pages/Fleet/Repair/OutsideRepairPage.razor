@page "/fleet/outside-repair"
@page "/fleet/outside-repair/{Id:int}"

@using VizarLibrary.Models.Accounts.Masters
@using VizarLibrary.Models.Fleet.Repair
@using VizarLibrary.Models.Fleet.Vehicle
@using VizarLibrary.Models.Operations

<PageTitle>Outside Repair - Vizar</PageTitle>

@if (_isLoading)
{
	<AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
	<div style="display: flex; flex-direction: column; min-height: 100vh;">
		<Header Title="Outside Repair" Subtitle="Create and manage outside repair transactions" ShowLogout="true"
				ShowHome="true" ShowBack="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack"
				OnLogoutClick="Logout">
			<RightContent>
				<IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Transaction (Ctrl + S)"
							Disabled="_isProcessing" OnClick="SaveTransaction" />
				@if (Id is > 0)
				{
					<IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Download Excel Invoice (Alt+E)"
								Disabled="_isProcessing" OnClick="DownloadExcelInvoice" />
					<IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Download PDF Invoice (Alt+P)"
								Disabled="_isProcessing" OnClick="DownloadPdfInvoice" />
				}
				<IconButton Icon="IconType.History" Title="Transaction History (Ctrl + H)" Disabled="_isProcessing"
							OnClick="NavigateToTransactionHistoryPage" />
				<IconButton Icon="IconType.Report" Title="Item Report (Ctrl + I)" Disabled="_isProcessing"
							OnClick="NavigateToItemReport" />
				<IconButton Icon="IconType.New" Title="New Transaction (Ctrl + N)" Disabled="_isProcessing"
							OnClick="ResetPage" />
			</RightContent>
		</Header>

		<!-- Main Content Container -->
		<div class="page-container">

			<!-- Top Section: Transaction Summary and Vehicle Info Side by Side -->
			<div class="two-column-layout">
				<!-- Transaction Summary Section -->
				<div class="section-card">
					<div class="section-header">
						<div class="section-title-wrapper">
							<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
								 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
								 stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
								<polyline points="14 2 14 8 20 8" />
								<line x1="16" y1="13" x2="8" y2="13" />
								<line x1="16" y1="17" x2="8" y2="17" />
								<polyline points="10 9 9 9 8 9" />
							</svg>
							<h2 class="section-title">Transaction Summary</h2>
						</div>
					</div>
					<div class="section-body">
						<div class="form-grid-single">
							<!-- Company -->
							<div class="form-field">
								<label class="field-label">
									Company <span class="required">*</span>
								</label>
								<SfAutoComplete Value="@_selectedCompany" TValue="CompanyModel" TItem="CompanyModel"
												DataSource="@_companies" Placeholder="Select a Company"
												FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
												FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
												CssClass="custom-autocomplete">
									<AutoCompleteEvents TItem="CompanyModel" TValue="CompanyModel"
														ValueChange="OnCompanyChanged" />
									<AutoCompleteFieldSettings Value="Name" />
								</SfAutoComplete>
							</div>

							<!-- Vendor -->
							<div class="form-field">
								<label class="field-label">
									Vendor <span class="required">*</span>
								</label>
								<SfAutoComplete Value="@_selectedVendor" TValue="LedgerModel" TItem="LedgerModel"
												DataSource="@_vendors" Placeholder="Select a Vendor"
												FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
												FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
												CssClass="custom-autocomplete">
									<AutoCompleteEvents TItem="LedgerModel" TValue="LedgerModel"
														ValueChange="OnVendorChanged" />
									<AutoCompleteFieldSettings Value="Name" />
								</SfAutoComplete>
							</div>

							<!-- Vehicle -->
							<div class="form-field">
								<label class="field-label">
									Vehicle <span class="required">*</span>
								</label>
								<SfAutoComplete Value="@_selectedVehicle" TValue="VehicleModel" TItem="VehicleModel"
												DataSource="@_vehicles" Placeholder="Select a Vehicle"
												FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
												FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
												CssClass="custom-autocomplete">
									<AutoCompleteEvents TItem="VehicleModel" TValue="VehicleModel"
														ValueChange="OnVehicleChanged" />
									<AutoCompleteFieldSettings Value="Code" />
								</SfAutoComplete>
							</div>

							<!-- Transaction Date and Financial Year -->
							<div class="form-field">
								<label class="field-label">
									Transaction Date <span class="required">*</span> / Financial Year
								</label>
								<div class="date-year-wrapper">
									<SfDatePicker Value="@_outsideRepair.TransactionDateTime" TValue="DateTime"
												  Format="dd/MM/yy" Placeholder="Select Date" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-datepicker">
										<DatePickerEvents TValue="DateTime" ValueChange="OnTransactionDateChanged" />
									</SfDatePicker>
									<SfTextBox
									Value="@($"{_selectedFinancialYear?.StartDate:yyyy} to {_selectedFinancialYear?.EndDate:yyyy}")"
									Readonly="true" Placeholder="Financial Year" FloatLabelType="FloatLabelType.Never"
									CssClass="custom-textbox readonly-field" />
								</div>
							</div>

							<!-- Current KM -->
							<div class="form-field">
								<label class="field-label">
									Current KM <span class="required">*</span>
								</label>
								<SfNumericTextBox @bind-Value="_outsideRepair.CurrentKM" TValue="decimal?" Min="0"
												  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-numeric editable-field" />
							</div>

							<!-- Current Hour -->
							<div class="form-field">
								<label class="field-label">
									Current Hour <span class="required">*</span>
								</label>
								<SfNumericTextBox @bind-Value="_outsideRepair.CurrentHour" TValue="decimal?" Min="0"
												  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-numeric editable-field" />
							</div>

							<!-- Approved By -->
							<div class="form-field">
								<label class="field-label">
									Approved By
								</label>
								<SfTextBox @bind-Value="_outsideRepair.ApprovedBy" Placeholder="Enter Approver Name"
										   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
							</div>

							<!-- Transaction No with Auto-generate -->
							<div class="form-field">
								<label class="field-label">
									Transaction No
								</label>
								<div class="transaction-no-wrapper">
									<SfTextBox @bind-Value="_outsideRepair.TransactionNo" Placeholder="Enter Transaction No"
											   FloatLabelType="FloatLabelType.Never" Readonly="@_autoGenerateTransactionNo"
											   CssClass="@(_autoGenerateTransactionNo ? "custom-textbox readonly-field" : "custom-textbox")" />
									<div class="auto-generate-checkbox">
										<SfCheckBox @bind-Checked="_autoGenerateTransactionNo" Label="Auto Generate"
													TChecked="bool" ValueChange="OnAutoGenerateTransactionNoChecked"
													CssClass="custom-checkbox" />
									</div>
								</div>
							</div>

							<!-- Remarks -->
							<div class="form-field">
								<label class="field-label">
									Remarks / Narration
								</label>
								<SfTextBox @bind-Value="_outsideRepair.Remarks" Multiline="true"
										   Placeholder="Enter remarks..." FloatLabelType="FloatLabelType.Never"
										   CssClass="custom-textbox textarea-field-small" />
							</div>
						</div>
					</div>
				</div>

				<!-- Summary Section -->
				<div class="section-card">
					<div class="section-header">
						<div class="section-title-wrapper">
							<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
								 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
								 stroke-linecap="round" stroke-linejoin="round">
								<line x1="12" y1="1" x2="12" y2="23" />
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
							</svg>
							<h2 class="section-title">Transaction Summary</h2>
						</div>
					</div>
					<div class="section-body">
						<div class="financial-grid">
							<!-- Total Items -->
							<div class="financial-row">
								<label class="financial-label">Total Jobs</label>
								<SfNumericTextBox Value="@_outsideRepair.TotalItems" Readonly="true" TValue="int"
												  ShowSpinButton="false" Placeholder="0" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-numeric readonly-field" />
							</div>

							<!-- Total Quantity -->
							<div class="financial-row">
								<label class="financial-label">Total Quantity</label>
								<SfNumericTextBox Value="@_outsideRepair.TotalQuantity" Readonly="true" TValue="decimal"
												  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-numeric readonly-field" />
							</div>

							<!-- Total Amount -->
							<div class="financial-row total-row">
								<label class="financial-label-total">Total Amount</label>
								<SfNumericTextBox Value="@_outsideRepair.TotalAmount" Readonly="true" TValue="decimal"
												  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
												  CssClass="custom-numeric total-field" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Add to Cart Section -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<circle cx="9" cy="21" r="1" />
							<circle cx="20" cy="21" r="1" />
							<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
						</svg>
						<h2 class="section-title">Add Job to Cart</h2>
					</div>
				</div>
				<div class="section-body">
					<!-- Single Row: All Cart Fields -->
					<div class="cart-row-single">
						<div class="cart-field cart-field-job">
							<label class="cart-label">Job / Work Description <span class="required">*</span></label>
							<SfTextBox @ref="_sfJobTextBox" @bind-Value="_selectedCart.Job"
									   Placeholder="Enter Job Description (Ctrl + E)" FloatLabelType="FloatLabelType.Never"
									   CssClass="custom-textbox" />
						</div>

						<div class="cart-field cart-field-small">
							<label class="cart-label">Qty</label>
							<SfNumericTextBox Value="@_selectedCart.Quantity" TValue="decimal" Min="0"
											  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
											  CssClass="custom-numeric editable-field">
								<NumericTextBoxEvents TValue="decimal" ValueChange="OnJobQuantityChanged" />
							</SfNumericTextBox>
						</div>

						<div class="cart-field cart-field-small">
							<label class="cart-label">Rate</label>
							<SfNumericTextBox Value="@_selectedCart.Rate" TValue="decimal" Min="0" ShowSpinButton="false"
											  Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
											  CssClass="custom-numeric editable-field">
								<NumericTextBoxEvents TValue="decimal" ValueChange="OnJobRateChanged" />
							</SfNumericTextBox>
						</div>

						<div class="cart-field cart-field-small">
							<label class="cart-label">Total</label>
							<SfNumericTextBox Value="@_selectedCart.Total" Readonly="true" TValue="decimal"
											  ShowSpinButton="false" Placeholder="0.00" FloatLabelType="FloatLabelType.Never"
											  CssClass="custom-numeric total-field-inline" />
						</div>

						<div class="cart-field cart-field-medium">
							<label class="cart-label">Remarks</label>
							<SfTextBox @bind-Value="_selectedCart.Remarks" Placeholder="Job Remarks..."
									   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
						</div>

						<div class="cart-field cart-field-button">
							<label class="cart-label">&nbsp;</label>
							<IconButton Icon="IconType.Add" Variant="ButtonVariant.Add" Text="Add" Title="Add to Cart"
										OnClick="AddJobToCart" />
						</div>
					</div>
				</div>
			</div>

			<!-- Cart Items Grid Section -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<path d="M3 3h7a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H3V3z" />
							<path d="M14 3h7v17h-7V3z" />
						</svg>
						<h2 class="section-title">Repair Jobs</h2>
					</div>
				</div>
				<div class="section-body grid-body">
					<SfGrid ID="_sfCartGrid" @ref="_sfCartGrid" DataSource="_cart" AllowTextWrap="true" AllowPaging="false"
							AllowSorting="true" AllowResizing="true" AllowFiltering="true" GridLines="GridLine.Horizontal"
							CssClass="professional-grid" Toolbar="@(new List<string>() { "Search" })">

						<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

						<GridAggregates>
							<GridAggregate>
								<GridAggregateColumns>
									<GridAggregateColumn Field="@nameof(OutsideRepairItemCartModel.Job)"
														 Type="AggregateType.Count">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
											}
											<div class="aggregate-label">
												<strong>Total Jobs: @aggregate.Count</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
									<GridAggregateColumn Field="@nameof(OutsideRepairItemCartModel.Quantity)"
														 Type="AggregateType.Sum">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
												var sum = aggregate.Sum != null ? Convert.ToDecimal(aggregate.Sum) : 0m;
											}
											<div class="aggregate-value">
												<strong>@sum.ToString("N2")</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
									<GridAggregateColumn Field="@nameof(OutsideRepairItemCartModel.Total)"
														 Type="AggregateType.Sum">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
												var sum = aggregate.Sum != null ? Convert.ToDecimal(aggregate.Sum) : 0m;
											}
											<div class="aggregate-value aggregate-total">
												<strong>@sum.ToString("N2")</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
								</GridAggregateColumns>
							</GridAggregate>
						</GridAggregates>

						<GridColumns>
							<GridColumn HeaderText="Actions" Width="100" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as dynamic);
										<div class="grid-actions">
											<IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid"
														Title="Edit Job (Insert)" OnClick="@(() => EditCartJob(item))" />
											<IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete"
														Size="ButtonSize.Grid" Title="Remove Job (Del)"
														OnClick="@(() => RemoveJobFromCart(item))" />
										</div>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(OutsideRepairItemCartModel.Job)" HeaderText="Job / Work Description"
										Width="250" />
							<GridColumn Field="@nameof(OutsideRepairItemCartModel.Quantity)" HeaderText="Qty" Width="100"
										TextAlign="TextAlign.Right" Format="N2" />
							<GridColumn Field="@nameof(OutsideRepairItemCartModel.Rate)" HeaderText="Rate" Width="110"
										TextAlign="TextAlign.Right" Format="N2" />
							<GridColumn Field="@nameof(OutsideRepairItemCartModel.Total)" HeaderText="Total" Width="130"
										TextAlign="TextAlign.Right" Format="N2">
								<Template>
									@{
										var item = (context as dynamic);
										<span class="grid-total">@item.Total.ToString("N2")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(OutsideRepairItemCartModel.Remarks)" HeaderText="Remarks"
										Width="150" />
						</GridColumns>
					</SfGrid>
				</div>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<style>
	/* Two Column Layout */
	.two-column-layout {
		display: flex;
		gap: 16px;
		margin-bottom: 16px;
	}

	.two-column-layout> :first-child {
		flex: 0 0 75%;
	}

	.two-column-layout> :last-child {
		flex: 0 0 calc(25% - 16px);
	}

	/* Form Grid Layout */
	.form-grid-single {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px 20px;
	}

	.form-field-double {
		grid-column: span 2;
	}

	/* Transaction Date and Financial Year Wrapper */
	.date-year-wrapper {
		display: flex;
		gap: 12px;
		align-items: stretch;
	}

	.date-year-wrapper> :first-child {
		flex: 1;
	}

	.date-year-wrapper> :last-child {
		flex: 1;
	}

	/* Transaction No with Auto-generate Wrapper */
	.transaction-no-wrapper {
		display: flex;
		gap: 12px;
		align-items: stretch;
	}

	.transaction-no-wrapper> :first-child {
		flex: 1;
	}

	.auto-generate-checkbox {
		display: flex;
		align-items: center;
		padding: 0 16px;
		background: #f8fafc;
		border: 1px solid #cbd5e1;
		border-radius: 6px;
		white-space: nowrap;
		min-width: 140px;
		justify-content: center;
	}

	.auto-generate-checkbox ::deep .custom-checkbox {
		font-size: 13px;
		font-weight: 500;
	}

	/* Financial Grid Layout */
	.financial-grid {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.financial-row {
		display: grid;
		grid-template-columns: 100px 1fr;
		align-items: center;
		gap: 10px;
	}

	.financial-row.total-row {
		margin-top: 4px;
		padding-top: 8px;
		border-top: 2px solid #e2e8f0;
	}

	.financial-label {
		font-size: 13px;
		font-weight: 500;
		color: #475569;
		text-align: right;
		white-space: nowrap;
	}

	.financial-label-total {
		font-size: 14px;
		font-weight: 700;
		color: #0f172a;
		text-align: right;
		white-space: nowrap;
	}

	::deep .editable-field .e-input-group {
		border-color: #3b82f6;
		background: #eff6ff;
	}

	::deep .editable-field .e-input-group input {
		font-weight: 600;
		color: #1e40af;
	}

	::deep .total-field .e-input-group {
		background: linear-gradient(135deg, #dbeafe 0%, #e0e7ff 100%);
		border: 2px solid #3b82f6;
		height: 48px;
	}

	::deep .total-field .e-input-group input {
		font-size: 18px;
		font-weight: 700;
		color: #1e40af;
	}

	::deep .textarea-field-small .e-input-group {
		height: auto;
		min-height: 60px;
	}

	::deep .textarea-field-small .e-input-group textarea {
		resize: vertical;
		min-height: 60px;
	}

	/* Add to Cart Section Styles - Single Row Layout */
	.cart-row-single {
		display: grid;
		grid-template-columns: 2.5fr 0.8fr 0.8fr 0.8fr 1.5fr 100px;
		gap: 12px;
		align-items: end;
	}

	.cart-field {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.cart-field-job {
		/* Standard column for job description */
	}

	.cart-field-small {
		/* Standard single column */
	}

	.cart-field-medium {
		/* Standard single column */
	}

	.cart-field-button {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.cart-label {
		font-size: 12px;
		font-weight: 600;
		color: #475569;
		text-transform: uppercase;
		letter-spacing: 0.3px;
	}

	.cart-label .required {
		color: #dc2626;
		margin-left: 2px;
	}

	::deep .cart-field .e-input-group,
	::deep .cart-field .custom-numeric .e-input-group,
	::deep .cart-field .custom-autocomplete .e-input-group,
	::deep .cart-field .custom-textbox .e-input-group {
		height: 38px;
		background: #eff6ff;
		border: 1px solid #3b82f6;
	}

	::deep .cart-field .e-input-group input,
	::deep .cart-field .custom-numeric .e-input-group input,
	::deep .cart-field .custom-autocomplete .e-input-group input,
	::deep .cart-field .custom-textbox .e-input-group input {
		font-size: 14px;
		font-weight: 500;
		color: #1e293b;
		padding: 8px 12px;
	}

	::deep .total-field-inline .e-input-group {
		background: linear-gradient(135deg, #dbeafe 0%, #e0e7ff 100%);
		border: 2px solid #3b82f6;
		height: 38px;
	}

	::deep .total-field-inline .e-input-group input {
		font-weight: 700;
		color: #1e40af;
	}
</style>