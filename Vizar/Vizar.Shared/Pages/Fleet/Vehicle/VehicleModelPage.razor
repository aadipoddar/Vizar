@page "/admin/vehicle-model"

@using VizarLibrary.Models.Fleet.Vehicle
@using VizarLibrary.Models.Inventory.Item

<PageTitle>Vehicle Model Management - Vizar</PageTitle>

@if (_isLoading)
{
    <AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Vehicle Model Management" Subtitle="Manage vehicle models and details" ShowHome="true"
                ShowBack="true" ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack"
                OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)"
                            Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)"
                            Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Vehicle Model (Ctrl + S)"
                            Disabled="_isProcessing" OnClick="SaveVehicleModel" />
                <IconButton Icon="IconType.New" Title="New Vehicle Model (Ctrl + N)" Disabled="_isProcessing"
                            OnClick="ResetPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

            <!-- Vehicle Model Entry Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5" />
                        </svg>
                        <h2 class="section-title">Vehicle Model Details</h2>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-grid">
                        <!-- Vehicle Model Name -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle Model Name <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_vehicleModel.Name" Placeholder="Enter vehicle model name"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Vehicle Model Code -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle Model Code <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_vehicleModel.Code" Placeholder="Enter vehicle model code"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Manufacturer -->
                        <div class="form-field">
                            <label class="field-label">
                                Manufacturer <span class="required">*</span>
                            </label>
                            <SfAutoComplete Value="@_selectedManufacturer" TValue="ManufacturerModel"
                                            TItem="ManufacturerModel" DataSource="@_manufacturers" Placeholder="Select Manufacturer"
                                            FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" CssClass="custom-autocomplete">
                                <AutoCompleteEvents TItem="ManufacturerModel" TValue="ManufacturerModel"
                                                    ValueChange="OnManufacturerChanged" />
                                <AutoCompleteFieldSettings Value="Name" />
                            </SfAutoComplete>
                        </div>

                        <!-- Remarks -->
                        <div class="form-field">
                            <label class="field-label">Remarks</label>
                            <SfTextBox @bind-Value="_vehicleModel.Remarks" Placeholder="Enter remarks (optional)"
                                       Multiline="true" FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vehicle Models List Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                        <h2 class="section-title">Vehicle Models List</h2>
                    </div>
                    <div class="header-actions">
                        <ToggleDeletedButton Disabled="@_isProcessing" ShowDeleted="@_showDeleted"
                                             OnToggle="ToggleDeleted" />
                    </div>
                </div>
                <div class="section-body grid-body">
                    <SfGrid @ref="_sfGrid" DataSource="@_vehicleModels" AllowPaging="true" AllowSorting="true"
                            AllowFiltering="true" AllowResizing="true" CssClass="professional-grid"
                            Toolbar="@(new List<string>() { "Search" })">
                        <GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                        <GridColumns>
                            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"
                                        AllowFiltering="false">
                                <Template>
                                    @{
                                        var vehicleModel = (context as VehicleModelModel);

                                        <div class="grid-actions">
                                            @if (vehicleModel.Status)
                                            {
                                                <IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid"
                                                            Title="Edit (Insert)" OnClick="@(() => OnEditVehicleModel(vehicleModel))" />
                                                <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete"
                                                            Size="ButtonSize.Grid" Title="Delete (Delete)"
                                                            OnClick="@(() => ShowDeleteConfirmation(vehicleModel.Id, vehicleModel.Name))" />
                                            }
                                            else
                                            {
                                                <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover"
                                                            Size="ButtonSize.Grid" Title="Recover (Delete)"
                                                            OnClick="@(() => ShowRecoverConfirmation(vehicleModel.Id, vehicleModel.Name))" />
                                            }
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(VehicleModelModel.Id)" HeaderText="ID" Width="80"
                                        TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(VehicleModelModel.Name)" HeaderText="Name" Width="300" />
                            <GridColumn Field="@nameof(VehicleModelModel.Code)" HeaderText="Code" Width="200" />
                            <GridColumn HeaderText="Manufacturer" Width="250">
                                <Template>
                                    @{
                                        var vehicleModel = (context as VehicleModelModel);
                                        var manufacturer = _manufacturers.FirstOrDefault(m => m.Id ==
                                        vehicleModel.ManufacturerId);
                                        <span>@manufacturer?.Name</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(VehicleModelModel.Remarks)" HeaderText="Remarks" Width="350" />
                            <GridColumn Field="@nameof(VehicleModelModel.Status)" HeaderText="Status" Width="100"
                                        TextAlign="TextAlign.Center">
                                <Template>
                                    @{
                                        var vehicleModel = (context as VehicleModelModel);
                                        <div class="grid-checkbox"
                                             style="@(vehicleModel.Status ? "color: #10b981; background: #d1fae5;" : "color: #dc2626; background: #fee2e2;")">
                                            @(vehicleModel.Status ? "✓" : "✗")
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>

        </div>

        <Footer />
    </div>
}

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog" EntityName="Vehicle Model"
                          IdentifierLabel="Vehicle Model Name" IdentifierValue="@_deleteVehicleModelName" IsPermanentDelete="false"
                          Disabled="@_isProcessing" OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog" EntityName="Vehicle Model"
                           IdentifierLabel="Vehicle Model Name" IdentifierValue="@_recoverVehicleModelName" Disabled="@_isProcessing"
                           OnConfirm="ConfirmRecover" OnCancel="CancelRecover" />

<ToastNotification @ref="_toastNotification" />