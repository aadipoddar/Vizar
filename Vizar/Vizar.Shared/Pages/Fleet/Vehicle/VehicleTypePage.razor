@page "/admin/vehicle-type"

@using VizarLibrary.Models.Fleet.Vehicle

<PageTitle>Vehicle Type Management - Vizar</PageTitle>

@if (_isLoading)
{
    <AnimatedLoader Visible="true" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Vehicle Type Management" Subtitle="Manage vehicle types and details" ShowHome="true" ShowBack="true" ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack" OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)" Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)" Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Vehicle Type (Ctrl + S)" Disabled="_isProcessing" OnClick="SaveVehicleType" />
                <IconButton Icon="IconType.New" Title="New Vehicle Type (Ctrl + N)" Disabled="_isProcessing" OnClick="ResetPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

        <!-- Vehicle Type Entry Section -->
        <div class="section-card">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5" />
                    </svg>
                    <h2 class="section-title">Vehicle Type Details</h2>
                </div>
            </div>
            <div class="section-body">
                <div class="form-grid-triple">
                    <!-- Vehicle Type Name -->
                    <div class="form-field">
                        <label class="field-label">
                            Vehicle Type Name <span class="required">*</span>
                        </label>
                        <SfTextBox @bind-Value="_vehicleType.Name" Placeholder="Enter vehicle type name"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Vehicle Type Code <span class="required">*</span>
                        </label>
                        <SfTextBox Value="@_vehicleType.Code" Placeholder="Auto-generated code" Readonly="true"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>

                    <!-- Remarks -->
                    <div class="form-field">
                        <label class="field-label">Remarks</label>
                        <SfTextBox @bind-Value="_vehicleType.Remarks" Placeholder="Enter remarks (optional)" Multiline="true"
                                   FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Vehicle Types List Section -->
        <div class="section-card">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                    </svg>
                    <h2 class="section-title">Vehicle Types List</h2>
                </div>
                <div class="header-actions">
                    <ToggleDeletedButton Disabled="@_isProcessing" ShowDeleted="@_showDeleted" OnToggle="ToggleDeleted" />
                </div>
            </div>
            <div class="section-body grid-body">
                <SfGrid @ref="_sfGrid" DataSource="@_vehicleTypes" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                        AllowResizing="true" CssClass="professional-grid" Toolbar="@(new List<string>() { "Search" })">
                    <GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                    <GridColumns>
                        <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center" AllowFiltering="false">
                            <Template>
                                @{
                                    var vehicleType = (context as VehicleTypeModel);

                                    <div class="grid-actions">
                                        @if (vehicleType.Status)
                                        {
                                            <IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid" Title="Edit (Insert)" OnClick="@(() => OnEditVehicleType(vehicleType))" />
                                            <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete" Size="ButtonSize.Grid" Title="Delete (Delete)" OnClick="@(() => ShowDeleteConfirmation(vehicleType.Id, vehicleType.Name))" />
                                        }
                                        else
                                        {
                                            <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover" Size="ButtonSize.Grid" Title="Recover (Delete)" OnClick="@(() => ShowRecoverConfirmation(vehicleType.Id, vehicleType.Name))" />
                                        }
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(VehicleTypeModel.Id)" HeaderText="ID" Width="80" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(VehicleTypeModel.Name)" HeaderText="Name" Width="300" />
                        <GridColumn Field="@nameof(VehicleTypeModel.Code)" HeaderText="Code" Width="200" />
                        <GridColumn Field="@nameof(VehicleTypeModel.Remarks)" HeaderText="Remarks" Width="400" />
                        <GridColumn Field="@nameof(VehicleTypeModel.Status)" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var vehicleType = (context as VehicleTypeModel);
                                    <div class="grid-checkbox" style="@(vehicleType.Status ? "color: #10b981; background: #d1fae5;" : "color: #dc2626; background: #fee2e2;")">
                                        @(vehicleType.Status ? "✓" : "✗")
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>

        </div>

        <Footer />
    </div>
}

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog"
                          EntityName="Vehicle Type"
                          IdentifierLabel="Vehicle Type Name"
                          IdentifierValue="@_deleteVehicleTypeName"
                          IsPermanentDelete="false"
                          Disabled="@_isProcessing"
                          OnConfirm="ConfirmDelete"
                          OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog"
                           EntityName="Vehicle Type"
                           IdentifierLabel="Vehicle Type Name"
                           IdentifierValue="@_recoverVehicleTypeName"
                           Disabled="@_isProcessing"
                           OnConfirm="ConfirmRecover"
                           OnCancel="CancelRecover" />

<ToastNotification @ref="_toastNotification" />