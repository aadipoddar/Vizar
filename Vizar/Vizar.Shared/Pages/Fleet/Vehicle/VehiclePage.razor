@page "/admin/vehicle"

@using VizarLibrary.Models.Fleet.Vehicle

<PageTitle>Vehicle Management - Vizar</PageTitle>

@if (_isLoading)
{
    <SfSpinner @bind-Visible="_isLoading" Label="Page is Loading, Please Wait" />
}
else
{
    <div style="display: flex; flex-direction: column; min-height: 100vh;">
        <Header Title="Vehicle Management" Subtitle="Manage vehicles and details" ShowHome="true" ShowBack="true" ShowLogout="true" OnHomeClick="NavigateToDashboard" OnBackClick="NavigateBack" OnLogoutClick="Logout">
            <RightContent>
                <IconButton Icon="IconType.Excel" Variant="ButtonVariant.Excel" Title="Export to Excel (Ctrl + E)" Disabled="_isProcessing" OnClick="ExportExcel" />
                <IconButton Icon="IconType.Pdf" Variant="ButtonVariant.Pdf" Title="Export to PDF (Ctrl + P)" Disabled="_isProcessing" OnClick="ExportPdf" />
                <IconButton Icon="IconType.Save" Variant="ButtonVariant.Save" Title="Save Vehicle (Ctrl + S)" Disabled="_isProcessing" OnClick="SaveVehicle" />
                <IconButton Icon="IconType.New" Title="New Vehicle (Ctrl + N)" Disabled="_isProcessing" OnClick="ResetPage" />
            </RightContent>
        </Header>

        <!-- Main Content Container -->
        <div class="page-container">

            <!-- Vehicle Entry Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5" />
                        </svg>
                        <h2 class="section-title">Vehicle Details</h2>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-grid-triple">
                        <!-- Vehicle Code -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle Code <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_vehicle.Code" Placeholder="Enter vehicle code"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Short Code -->
                        <div class="form-field">
                            <label class="field-label">
                                Short Code <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_vehicle.ShortCode" Placeholder="Enter short code"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Chasis Code -->
                        <div class="form-field">
                            <label class="field-label">
                                Chasis Code <span class="required">*</span>
                            </label>
                            <SfTextBox @bind-Value="_vehicle.ChasisCode" Placeholder="Enter chasis code"
                                       FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>

                        <!-- Vehicle Type -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle Type <span class="required">*</span>
                            </label>
                            <SfAutoComplete Value="@_selectedVehicleType" TValue="VehicleTypeModel" TItem="VehicleTypeModel"
                                            DataSource="@_vehicleTypes" Placeholder="Select Vehicle Type"
                                            FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" CssClass="custom-autocomplete">
                                <AutoCompleteEvents TItem="VehicleTypeModel" TValue="VehicleTypeModel"
                                                    ValueChange="OnVehicleTypeChanged" />
                                <AutoCompleteFieldSettings Value="Name" />
                            </SfAutoComplete>
                        </div>

                        <!-- Vehicle Model -->
                        <div class="form-field">
                            <label class="field-label">
                                Vehicle Model <span class="required">*</span>
                            </label>
                            <SfAutoComplete Value="@_selectedVehicleModel" TValue="VehicleModelModel"
                                            TItem="VehicleModelModel" DataSource="@_vehicleModels" Placeholder="Select Vehicle Model"
                                            FloatLabelType="FloatLabelType.Never" AllowFiltering="true"
                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" CssClass="custom-autocomplete">
                                <AutoCompleteEvents TItem="VehicleModelModel" TValue="VehicleModelModel"
                                                    ValueChange="OnVehicleModelChanged" />
                                <AutoCompleteFieldSettings Value="Name" />
                            </SfAutoComplete>
                        </div>

                        <!-- Purchase Date -->
                        <div class="form-field">
                            <label class="field-label">
                                Purchase Date <span class="required">*</span>
                            </label>
                            <SfDatePicker TValue="DateTime" @bind-Value="_vehicle.PurchaseDate"
                                          Placeholder="Select Purchase Date" Format="dd-MM-yyyy" FloatLabelType="FloatLabelType.Never"
                                          CssClass="custom-textbox" />
                        </div>

                        <!-- Opening Hour -->
                        <div class="form-field">
                            <label class="field-label">Opening Hour</label>
                            <SfNumericTextBox @bind-Value="_vehicle.OpeningHour" Placeholder="Enter opening hour"
                                              Format="N2" FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox"
                                              TValue="decimal?" Min="0" />
                        </div>

                        <!-- Opening KM -->
                        <div class="form-field">
                            <label class="field-label">Opening KM</label>
                            <SfNumericTextBox @bind-Value="_vehicle.OpeningKM" Placeholder="Enter opening KM" Format="N2"
                                              FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" TValue="decimal?" Min="0" />
                        </div>

                        <!-- Remarks -->
                        <div class="form-field form-field-span-3">
                            <label class="field-label">Remarks</label>
                            <SfTextBox @bind-Value="_vehicle.Remarks" Placeholder="Enter remarks (optional)"
                                       Multiline="true" FloatLabelType="FloatLabelType.Never" CssClass="custom-textbox" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vehicles List Section -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                        <h2 class="section-title">Vehicles List</h2>
                    </div>
                    <div class="header-actions">
                        <ToggleDeletedButton Disabled="@_isProcessing" ShowDeleted="@_showDeleted"
                                             OnToggle="ToggleDeleted" />
                    </div>
                </div>
                <div class="section-body grid-body">
                    <SfGrid @ref="_sfGrid" DataSource="@_vehicles" AllowPaging="true" AllowSorting="true"
                            AllowFiltering="true" AllowResizing="true" CssClass="professional-grid"
                            Toolbar="@(new List<string>() { "Search" })">
                        <GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                        <GridColumns>
                            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"
                                        AllowFiltering="false">
                                <Template>
                                    @{
                                        var vehicle = (context as VehicleModel);

                                        <div class="grid-actions">
                                            @if (vehicle.Status)
                                            {
                                                <IconButton Icon="IconType.Edit" Variant="ButtonVariant.Edit" Size="ButtonSize.Grid"
                                                            Title="Edit (Insert)" OnClick="@(() => OnEditVehicle(vehicle))" />
                                                <IconButton Icon="IconType.Delete" Variant="ButtonVariant.Delete"
                                                            Size="ButtonSize.Grid" Title="Delete (Delete)"
                                                            OnClick="@(() => ShowDeleteConfirmation(vehicle.Id, vehicle.Code))" />
                                            }
                                            else
                                            {
                                                <IconButton Icon="IconType.Recover" Variant="ButtonVariant.Recover"
                                                            Size="ButtonSize.Grid" Title="Recover (Delete)"
                                                            OnClick="@(() => ShowRecoverConfirmation(vehicle.Id, vehicle.Code))" />
                                            }
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(VehicleModel.Id)" HeaderText="ID" Width="80"
                                        TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(VehicleModel.Code)" HeaderText="Code" Width="150" />
                            <GridColumn Field="@nameof(VehicleModel.ShortCode)" HeaderText="Short Code" Width="120" />
                            <GridColumn Field="@nameof(VehicleModel.ChasisCode)" HeaderText="Chasis Code" Width="150" />
                            <GridColumn HeaderText="Vehicle Type" Width="150">
                                <Template>
                                    @{
                                        var vehicle = (context as VehicleModel);
                                        var vehicleType = _vehicleTypes.FirstOrDefault(vt => vt.Id == vehicle.VehicleTypeId);
                                        <span>@vehicleType?.Name</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Vehicle Model" Width="180">
                                <Template>
                                    @{
                                        var vehicle = (context as VehicleModel);
                                        var vehicleModel = _vehicleModels.FirstOrDefault(vm => vm.Id == vehicle.VehicleModelId);
                                        <span>@vehicleModel?.Name</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(VehicleModel.PurchaseDate)" HeaderText="Purchase Date" Width="130"
                                        Format="dd-MM-yyyy" TextAlign="TextAlign.Center" />
                            <GridColumn Field="@nameof(VehicleModel.OpeningHour)" HeaderText="Opening Hour" Width="120"
                                        Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(VehicleModel.OpeningKM)" HeaderText="Opening KM" Width="120"
                                        Format="N2" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(VehicleModel.Remarks)" HeaderText="Remarks" Width="250" />
                            <GridColumn Field="@nameof(VehicleModel.Status)" HeaderText="Status" Width="100"
                                        TextAlign="TextAlign.Center">
                                <Template>
                                    @{
                                        var vehicle = (context as VehicleModel);
                                        <div class="grid-checkbox"
                                             style="@(vehicle.Status ? "color: #10b981; background: #d1fae5;" : "color: #dc2626; background: #fee2e2;")">
                                            @(vehicle.Status ? "✓" : "✗")
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>

        </div>

        <Footer />
    </div>
}

<DeleteConfirmationDialog @ref="_deleteConfirmationDialog" EntityName="Vehicle" IdentifierLabel="Vehicle Code"
                          IdentifierValue="@_deleteVehicleCode" IsPermanentDelete="false" Disabled="@_isProcessing" OnConfirm="ConfirmDelete"
                          OnCancel="CancelDelete" />

<RecoverConfirmationDialog @ref="_recoverConfirmationDialog" EntityName="Vehicle" IdentifierLabel="Vehicle Code"
                           IdentifierValue="@_recoverVehicleCode" Disabled="@_isProcessing" OnConfirm="ConfirmRecover"
                           OnCancel="CancelRecover" />

<!-- Toast Notification -->
<ToastNotification @ref="_toastNotification" />

<style>
    * {
        box-sizing: border-box;
    }

    /* Section Card */
    .section-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .section-header {
        padding: 20px 24px;
        border-bottom: 2px solid #e2e8f0;
        background: linear-gradient(to bottom, #ffffff 0%, #f8fafc 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .section-icon {
        color: #3b82f6;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .section-body {
        padding: 24px;
    }

    /* Form Grid */
    .form-grid-triple {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        align-items: start;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-field-span-2 {
        grid-column: span 2;
    }

    .form-field-span-3 {
        grid-column: span 3;
    }

    .field-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 2px;
    }

    .required {
        color: #dc2626;
        margin-left: 2px;
    }

    /* Grid Body */
    .grid-body {
        padding: 0;
    }

    .professional-grid {
        border: none;
    }

    .grid-checkbox {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 14px;
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .form-grid-triple {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .form-grid-triple {
            grid-template-columns: 1fr;
        }
    }
</style>